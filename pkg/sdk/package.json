{
  "name": "@senhor-f/sdk",
  "version": "2.1.0",
  "description": "Universal TypeScript SDK and Viem client for Economic Zones Protocol ($HNY v2) - Bonding Curves, Vaults, Subscriptions, Payroll, AI Micropayments, and KZG Blobs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/senhor-f/economic-zones.git"
  },
  "scripts": {
    "build:abis": "node scripts/buildAbis.mjs",
    "build": "bun run build:abis && tsc && cp src/abis.json src/abis.jsonl dist/",
