    "sdk",
    "economic-zones",
    "hny",
    "bonding-curve",
    "erc4626",
    "viem",
    "solidity",
    "eip-4844",
    "xerc20",
    "x402",
    "ai-payments"
  ],
  "author": "senhor-f",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
